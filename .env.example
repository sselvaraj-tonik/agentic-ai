# Application Environment
# Valid values: development | sit | uat | production
# (development uses Ollama; sit/uat/production use vLLM)
APP_ENV=development

# ── LLM Configuration ──────────────────────────────────────
LLM_PROVIDER=ollama  #ollama|vllm

# Ollama (development only)
OLLAMA_MODEL=llama3.1 #llama3.1|qwen2.5:7b|qwen2.5:14b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional lighter routing model (falls back to OLLAMA_MODEL)
# OLLAMA_SUPERVISOR_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=-1   # -1 = keep model loaded indefinitely

# vLLM (sit / uat / production)
# LLM_PROVIDER=vllm
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# VLLM_BASE_URL=http://vllm-server:8000/v1
# VLLM_API_KEY=your-api-key
# VLLM_EMBED_MODEL=BAAI/bge-base-en-v1.5   # embedding model your vLLM serves
# VLLM_SUPERVISOR_MODEL=          # optional; must be served by your vLLM

# ── API Configuration ──────────────────────────────────────
BANK_API_BASE_URL=https://test.alb.tonikbank.com/customer/v1/
API_TIMEOUT=10

# ── Database Configuration ─────────────────────────────────
DATABASE_URL=postgresql+psycopg://suriya:123@localhost:5432/postgres

# ── Persistence ────────────────────────────────────────────
PERSISTENCE_TYPE=memory   # memory (dev) | postgres (sit/uat/prod)

# ── Security & Compliance ──────────────────────────────────
ENABLE_PII_MASKING=False  # True in sit/uat/prod

# ── Application ────────────────────────────────────────────
APP_NAME="Banking Agent AI"
APP_VERSION=1.2.0
DEBUG=True
