# Application Environment
APP_ENV=development

# LLM Configuration
LLM_PROVIDER=ollama  #ollama|vllm
OLLAMA_MODEL=llama3.1 #llama3.1|qwen2.5:14b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: lighter model used only for supervisor routing (faster classification).
# Leave commented to reuse OLLAMA_MODEL.
# OLLAMA_SUPERVISOR_MODEL=qwen2.5:3b

# Ollama model keep-alive in seconds (-1 = keep loaded indefinitely, 0 = unload immediately)
OLLAMA_KEEP_ALIVE=-1

# API Configuration
BANK_API_BASE_URL=https://test.alb.tonikbank.com/customer/v1/
DRUPAL_FAQ_URL=http://staging3.tonikbank.com/jsonapi/node/faq
API_TIMEOUT=10

# Database Configuration
DATABASE_URL=postgresql+psycopg://suriya:123@localhost:5432/postgres

# Persistence Configuration  \\ memory|postgres
PERSISTENCE_TYPE=memory

# Security & Compliance   \\ True|False
ENABLE_PII_MASKING=True

# Application Configuration
APP_NAME="Banking Agent AI (STAGING)"
APP_VERSION=1.2.0
DEBUG=True