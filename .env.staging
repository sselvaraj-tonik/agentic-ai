# Application Environment
APP_ENV=staging

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Lightweight model used only for supervisor routing (faster classification)
OLLAMA_SUPERVISOR_MODEL=qwen2.5:3b

# Keep models resident in GPU memory indefinitely to avoid reload thrash
OLLAMA_KEEP_ALIVE=-1

# API Configuration
BANK_API_BASE_URL=https://test.alb.tonikbank.com/customer/v1/
DRUPAL_FAQ_URL=http://staging3.tonikbank.com/jsonapi/node/faq
API_TIMEOUT=10

# Database Configuration
DATABASE_URL=postgresql://suriya:123@localhost:5432/postgres

# Persistence Configuration
PERSISTENCE_TYPE=memory

# Security & Compliance
ENABLE_PII_MASKING=False

# Application Configuration
APP_NAME="Banking Agent AI (STAGING)"
APP_VERSION=1.2.0
DEBUG=False
