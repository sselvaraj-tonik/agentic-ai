# Application Environment
APP_ENV=staging

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://staging-ollama:11434

# API Configuration
BANK_API_BASE_URL=https://test.alb.tonikbank.com/customer/v1/
DRUPAL_FAQ_URL=http://staging3.tonikbank.com/jsonapi/node/faq
API_TIMEOUT=10

# Database Configuration
DATABASE_URL=postgresql+psycopg://staging_user:staging_pass@staging-db:5432/postgres

# Persistence Configuration
PERSISTENCE_TYPE=postgres

# Security & Compliance
ENABLE_PII_MASKING=True

# Application Configuration
APP_NAME="Banking Agent AI (STAGING)"
APP_VERSION=1.2.0
DEBUG=True
