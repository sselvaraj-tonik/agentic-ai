# Application Environment
APP_ENV=production

# LLM Configuration
LLM_PROVIDER=vllm
VLLM_MODEL=llama3.1
VLLM_BASE_URL=http://vllm-server:8000/v1
VLLM_API_KEY=your-api-key

# API Configuration
BANK_API_BASE_URL=https://api.tonikbank.com/customer/v1/
DRUPAL_FAQ_URL=https://tonikbank.com/jsonapi/node/faq
API_TIMEOUT=5

# Database Configuration
DATABASE_URL=postgresql+psycopg://prod_user:prod_pass@prod-db:5432/postgres

# Persistence Configuration
PERSISTENCE_TYPE=postgres

# Security & Compliance
ENABLE_PII_MASKING=True

# Application Configuration
APP_NAME="Banking Agent AI (PROD)"
APP_VERSION=1.2.0
DEBUG=False
