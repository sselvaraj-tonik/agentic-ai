# Application Environment
APP_ENV=production

# LLM Configuration  (vLLM only)
LLM_PROVIDER=vllm
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_BASE_URL=http://vllm-server:8000/v1
VLLM_API_KEY=your-api-key
VLLM_EMBED_MODEL=BAAI/bge-base-en-v1.5

# Optional: dedicated supervisor routing model. Must be a model your vLLM
# server actually serves; leave commented to reuse VLLM_MODEL.
# VLLM_SUPERVISOR_MODEL=

# API Configuration
BANK_API_BASE_URL=https://api.tonikbank.com/customer/v1/
API_TIMEOUT=5

# Database Configuration
DATABASE_URL=postgresql+psycopg://prod_user:prod_pass@prod-db:5432/postgres

# Persistence Configuration
PERSISTENCE_TYPE=postgres

# Security & Compliance
ENABLE_PII_MASKING=True

# Application Configuration
APP_NAME="Banking Agent AI (PROD)"
APP_VERSION=1.2.0
DEBUG=False
