# Application Environment
APP_ENV=development

# LLM Configuration  (development is the ONLY environment that uses Ollama)
LLM_PROVIDER=ollama  #ollama|vllm
OLLAMA_MODEL=llama3.1 #llama3.1|qwen2.5:7b|qwen2.5:14b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: lighter model used only for supervisor routing (falls back to OLLAMA_MODEL)
# OLLAMA_SUPERVISOR_MODEL=qwen2.5:3b

# Keep models resident in GPU memory (-1 = indefinitely, 0 = unload immediately)
OLLAMA_KEEP_ALIVE=-1

# API Configuration
BANK_API_BASE_URL=https://test.alb.tonikbank.com/customer/v1/
API_TIMEOUT=10

# Database Configuration
DATABASE_URL=postgresql+psycopg://suriya:123@localhost:5432/postgres

# Persistence Configuration  \\ memory|postgres
PERSISTENCE_TYPE=memory

# Security & Compliance   \\ True|False
ENABLE_PII_MASKING=False

# Application Configuration
APP_NAME="Banking Agent AI (DEV)"
APP_VERSION=1.2.0
DEBUG=True
